<Project>
    <!--
        NativeAOT for Android (linux-bionic), linked with the Android NDK's clang.
        Requires the ANDROID_NDK_ROOT environment variable (or -p:ANDROID_NDK_ROOT=...), NDK r26 or newer.
    -->
    <PropertyGroup>
        <AndroidApiLevel Condition="'$(AndroidApiLevel)' == ''">24</AndroidApiLevel>
        <NdkHost Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows-x86_64</NdkHost>
        <NdkHost Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x86_64</NdkHost>
        <NdkHost Condition="$([MSBuild]::IsOSPlatform('OSX'))">darwin-x86_64</NdkHost>
        <NdkExeSuffix Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</NdkExeSuffix>
        <NdkBin>$([MSBuild]::EnsureTrailingSlash('$(ANDROID_NDK_ROOT)'))toolchains/llvm/prebuilt/$(NdkHost)/bin/</NdkBin>
        <NdkTarget Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">aarch64-linux-android$(AndroidApiLevel)</NdkTarget>
        <NdkTarget Condition="$(RuntimeIdentifier.EndsWith('-x64'))">x86_64-linux-android$(AndroidApiLevel)</NdkTarget>

        <!-- The NDK's per-target clang wrappers. ILCompiler looks the linker up on PATH, so the NDK's bin folder
             must be on PATH (build-android scripts do this). -->
        <CppCompilerAndLinker>$(NdkTarget)-clang</CppCompilerAndLinker>
        <CppCompilerAndLinker Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(NdkTarget)-clang.cmd</CppCompilerAndLinker>
        <ObjCopyName>llvm-objcopy</ObjCopyName>
        <!-- The NDK sysroot is found by clang from the target triple -->
        <SysRoot>$([MSBuild]::EnsureTrailingSlash('$(ANDROID_NDK_ROOT)'))toolchains/llvm/prebuilt/$(NdkHost)/sysroot</SysRoot>
    </PropertyGroup>

    <ItemGroup>
        <LinkerArg Include="--target=$(NdkTarget)" />
        <!-- Required for libraries loaded through System.loadLibrary -->
        <LinkerArg Include="-Wl,-z,noexecstack" />
        <!-- Android 15+ devices may use 16 KB pages -->
        <LinkerArg Include="-Wl,-z,max-page-size=16384" />
        <!-- Dobby is C++; Android has no shared libstdc++, so link the NDK's libc++ statically -->
        <LinkerArg Include="-static-libstdc++" />
    </ItemGroup>

    <Target Name="CheckAndroidNdk" BeforeTargets="SetupOSSpecificProps">
        <Error Condition="'$(ANDROID_NDK_ROOT)' == '' Or !Exists('$(NdkBin)clang$(NdkExeSuffix)')"
               Text="Building for Android needs the Android NDK. Set ANDROID_NDK_ROOT to its folder (expected clang at '$(NdkBin)clang$(NdkExeSuffix)')." />
    </Target>

    <!-- Newer NDK linkers reject _init/_fini in version scripts -->
    <Target Name="RemoveInitFiniExports" AfterTargets="IlcCompile" BeforeTargets="LinkNative">
        <WriteLinesToFile File="$(ExportsFile)"
                          Lines="$([System.IO.File]::ReadAllText($(ExportsFile)).Replace('global: _init; _fini;','global: '))"
                          Overwrite="true" />
    </Target>
</Project>
